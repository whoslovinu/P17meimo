# ============================================================
# P17 H5 魅魔来袭 — Environment Configuration
# DO NOT COMMIT THIS FILE TO SOURCE CONTROL
# ============================================================
#
# IMPORTANT: Never commit real secrets to the repository.
# Copy this file to .env.local and fill in actual values.
# .env.local is already in .gitignore
#
# ──────────────────────────────────────────────────────────
# DEVELOPMENT (localhost)
# ──────────────────────────────────────────────────────────

# ──────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT (with SSH tunnel to AWS VPC)
# ──────────────────────────────────────────────────────────
#
# IMPORTANT: Before running `npm run dev`, start the tunnel in a separate terminal:
#   $env:DEPLOY_SSH_PASSPHRASE='REPARK'; node scripts/dev_tunnel.mjs
#
# The tunnel forwards:
#   localhost:5433 -> RDS:5432  (PostgreSQL)
#   localhost:6380 -> ElastiCache:6379 (Redis)
#
# PostgreSQL — via SSH tunnel (local dev only)
# Replace USER, PASSWORD, HOST, PORT, DATABASE with your own local values.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME"

# Redis — via SSH tunnel (local dev only)
# For local dev with TLS, point at your tunnel; in production set REDIS_TLS=true
# and the real ElastiCache/Redis endpoint provided by your hosting platform.
REDIS_URL="redis://HOST:6379"

# ─── DEPRECATED ──────────────────────────────────────────────────────────────
# The Supabase SaaS project previously referenced in this file
# (`ntjfmvjdewbhkydzdlhj.supabase.co`) is DECOMMISSIONED. The application
# no longer connects to it. All persistence is now on AWS RDS, accessed
# via the local SSH tunnel. Do NOT set the variables below — the codebase
# no longer reads them. They are kept here ONLY as a tombstone so a future
# operator does not accidentally re-introduce the dependency.
#   SUPABASE_URL=<removed>
#   SUPABASE_SERVICE_ROLE_KEY=<removed>
# ────────────────────────────────────────────────────────────────────────────

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin authentication — HMAC-SHA256 signed token (see app/api/admin/login/route.ts)
# This secret is used to sign the admin_token cookie via HMAC-SHA256.
# The cookie is a time-limited token: {expiry_timestamp}:{HMAC-SHA256(secret, expiry)}.
# NEVER set this in local dev (the system falls back gracefully).
# In production, generate a strong random secret: openssl rand -hex 32
# ADMIN_SECRET_KEY=<generate-with-openssl-rand-hex-32>

# Webhook signature verification secret (HMAC-SHA256).
# Shared with your Main Station integration partner.
# Length: ≥32 characters (64+ hex recommended).
# Generate locally with:  openssl rand -hex 32
# DO NOT commit a real value to source control. Set in:
#   - .env.local               for local dev (gitignored)
#   - .env.production          for the deployed host (gitignored)
#   - hosting platform Secrets for staging / production
# If WEBHOOK_SECRET is missing or shorter than 32 chars the application
# refuses to send signed callbacks and rejects incoming signatures with 500.
WEBHOOK_SECRET="your_webhook_secret_here_minimum_32_chars"

# ──────────────────────────────────────────────────────────
# Commander (Owner) Remote Control — Phase 10 Hooks 3 + 4
# ──────────────────────────────────────────────────────────
#
# OWNER_COMMAND_KEY — HMAC-SHA256 key for the /api/internal/owner-command
# endpoint. The customer MUST NOT know this value. Generate with:
#   node scripts/generate-owner-key.mjs --label=OWNER_COMMAND_KEY
# Then store it:
#   - In YOUR password manager (1Password / Bitwarden / KeePass)
#   - On the customer's EC2 at /etc/repark/owner.env (chmod 600)
#   - NEVER commit it to source control
#
# Leave UNSET in development unless you're testing the endpoint locally.
# OWNCOMMAND_KEY min length: 32 chars.
# OWNER_COMMAND_KEY=<64-hex-chars>

# OWNER_HEARTBEAT_URL / OWNER_HEARTBEAT_KEY — OPTIONAL startup license check.
# When BOTH are set, /api/internal/startup signs a GET to the URL with
# OWNER_HEARTBEAT_KEY before declaring the server ready. If the URL replies
# non-OK or is unreachable, Next.js refuses to start.
#
# Leave BOTH UNSET to disable the heartbeat (default). The deployment still
# boots normally.
# OWNER_HEARTBEAT_URL=https://your-license-check.example.com/heartbeat
# OWNER_HEARTBEAT_KEY=<64-hex-chars>

# ──────────────────────────────────────────────────────────
# User Auth — Client Cookie Integration
# ──────────────────────────────────────────────────────────

# Cookie name that the Main Station portal sets to carry the user ID.
# Clients that pass auth via cookie (e.g. from an iframe or webview) set this.
# Default: "uid"  (matches the legacy dev-mode behaviour)
NEXT_PUBLIC_AUTH_COOKIE_NAME=uid

# URL of the Main Station login page. When middleware detects no auth cookie
# on /battle or /api/game/* routes, the user is redirected here.
# Replace with the real Main Station portal URL provided by your integration team.
NEXT_PUBLIC_MAIN_STATION_URL=https://your-main-station.example.com/login

# Outbound energy-reward callback URL (H5 → Main Station).
# Replace with the real endpoint shared by the integration team.
# When MAIN_STATION_ADD_ENERGY_URL is unset, the application falls back to a
# safe placeholder URL — NEVER a production endpoint with a hard-coded secret.
MAIN_STATION_ADD_ENERGY_URL=https://your-main-station.example.com/api/webhook/activity/reward

# ──────────────────────────────────────────────────────────
# Badge Adapter — Main Station is the single source of truth for badge metadata.
# REPARK 7.0 P1-77 (2026-09-11): required by lib/services/badgeAdapter.ts.
# These URLs MUST be reachable from the production server (port 443 outbound).
# The adapter signs with the SAME WEBHOOK_SECRET as energy.
# When either URL is unset, BadgeAdapter throws CONFIG_ERROR at module load
# and the Next.js server refuses to start — operators must set BOTH before deploy.
# Phase A (preview): /api/admin/badge/preview → MAIN_STATION_BADGE_DETAIL_URL
# Phase A (grant):  /api/battle/reward-claim → MAIN_STATION_BADGE_GRANT_URL
# MAIN_STATION_BADGE_DETAIL_URL=
# MAIN_STATION_BADGE_GRANT_URL=

# ──────────────────────────────────────────────────────────
# PRODUCTION DEPLOYMENT (AWS EC2 / Vercel / Railway)
# ──────────────────────────────────────────────────────────
#
# For production, set these environment variables in your hosting platform
# (Vercel Environment Variables, Railway Variables, AWS Systems Manager, etc.).
# DO NOT add production values to this file.
#
# ── AWS ElastiCache Redis ────────────────────────────────
# Endpoint provided by client: rp1-bkmbmc.serverless.use1.cache.amazonaws.com
# Port: 6379 (standard)
# REDIS_URL=redis://rp1-bkmbmc.serverless.use1.cache.amazonaws.com:6379
#
# For AWS ElastiCache with TLS (recommended for production):
# REDIS_URL=rediss://rp1-bkmbmc.serverless.use1.cache.amazonaws.com:6379
# REDIS_TLS=true
#
# ── Supabase (DEPRECATED — see note above) ──────────────────
# The application no longer talks to any Supabase project.
# AWS RDS PostgreSQL is the single source of truth, accessed via
# DATABASE_URL through the local SSH tunnel (or the production
# direct endpoint in hosted environments).
#
# ── Application ──────────────────────────────────────────
# NEXT_PUBLIC_APP_URL=https://your-production-domain.com
# NEXT_PUBLIC_AUTH_COOKIE_NAME=<cookie key from Main Station integration team>
# NEXT_PUBLIC_MAIN_STATION_URL=<your Main Station login URL>
# ADMIN_SECRET=<strong random password — change from dev default>
#
# ── Security ─────────────────────────────────────────────
# NODE_ENV=production    (set by hosting platform automatically on Vercel/Railway)
# WEBHOOK_SECRET=<32+ char secret shared with Main Station — TODO(p2)>
